theme
  fonts default:"inter" install:["inter","manrope"]
  design defaultTheme:"reference-dark"
    Card variant:"soft" scheme:"surface" radius:"xl" shadow:"sm"
    Button variant:"solid" scheme:"primary" radius:"full" size:"md"
    Chip variant:"soft" scheme:"primary" radius:"full" size:"sm"
    Text font:"inter"
    Title font:"manrope"
    theme name:"reference-dark"
      colors:
        primary color:"#b9ef61" text:"#08110d" title:"#08110d"
        softPrimary color:"#193624" text:"#dfffc9" title:"#dfffc9"
        secondary color:"#6dd7ff" text:"#05131a" title:"#05131a"
        softSecondary color:"#123246" text:"#d7f5ff" title:"#d7f5ff"
        tertiary color:"#8e83ff" text:"#0a081b" title:"#0a081b"
        softTertiary color:"#282454" text:"#ebe8ff" title:"#ebe8ff"
        muted color:"#8f9aae" text:"#060917" title:"#060917"
        softMuted color:"#11172a" text:"#d6ddec" title:"#d6ddec"
        background color:"#050816" text:"#f6f8ff" title:"#f6f8ff"
        surface color:"#0b1227" text:"#f7f9ff" title:"#f7f9ff"
        success color:"#58d69b" text:"#04130d" title:"#04130d"
        softSuccess color:"#12372a" text:"#d8ffeb" title:"#d8ffeb"
        info color:"#5bbef4" text:"#04131c" title:"#04131c"
        softInfo color:"#123149" text:"#dff5ff" title:"#dff5ff"
        warning color:"#e6b95f" text:"#181004" title:"#181004"
        softWarning color:"#493718" text:"#fff0c7" title:"#fff0c7"
        danger color:"#f17886" text:"#1a0508" title:"#1a0508"
        softDanger color:"#4c2028" text:"#ffe1e6" title:"#ffe1e6"
