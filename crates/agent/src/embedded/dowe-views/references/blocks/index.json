    "note": "The catalog stores selection metadata, not complete documentation pages or embedded screenshots."
  },
  "retrieval": {
    "maxCandidates": 5,
    "recommendedSelection": "Choose one primary block and at most one supporting block; combine family defaults with variant tags.",
    "uiFilter": "For UI generation, ignore entries whose kind is server.",
    "sourcePolicy": "Generate Dowe source from the selected pattern and current compiler contracts; do not copy documentation gallery wrappers."
